        <translations>
          <translation type="subtitle" xml:lang="zh-Hans">
            <text for="L1">哦，科伊塔尔，我向你献上祷歌</text>
            <text for="L2">求你使我们得胜</text>
            <text for="L3">求你庇佑我等的征战，真福的科伊塔尔</text>
            <text for="L4">求你庇佑我等的征战，真福的科伊塔尔</text>
            <text for="L5">求你庇佑我等的征战，真福的科伊塔尔</text>
            <text for="L6">求你庇佑我等的征战，真福的科伊塔尔</text>
            <text for="L7">求你使大地战抖，使城邑震颤</text>
            <text for="L8">求你使大地战抖，使城邑震颤</text>
            <text for="L9">求你使大地战抖，使城邑震颤</text>
            <text for="L10">求你使大地战抖，使城邑震颤</text>
            <text for="L11">求你庇佑我等的征战，真福的科伊塔尔</text>
            <text for="L12">求你庇佑我等的征战，真福的科伊塔尔</text>
            <text for="L13">求你庇佑我等的征战，真福的科伊塔尔</text>
            <text for="L14">求你庇佑我等的征战，真福的科伊塔尔</text>
          </translation>
        </translations>
        <transliterations></transliterations>
      </iTunesMetadata>
