      <iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal">
        <translations>
          <translation type="subtitle" xml:lang="zh-Hans">
            <text for="L1">当你面容枯萎 飓风大作</text>
            <text for="L2">这便是在我脚下粉碎的世界</text>
            <text for="L3">烈火与风暴，降雪与迷雾</text>
            <text for="L4">忍痛于怀，辅我知觉</text>
            <text for="L5">女王万岁 不绝于耳</text>
            <text for="L6">阴晴圆缺有其涨落</text>
            <text for="L7">休止声声无休无止</text>
            <text for="L8">侧耳倾听汝之心声</text>
            <text for="L9">在你的失色的瞳仁中我看见自己</text>
            <text for="L10">幻觉过后我的情感倾泻而出</text>
            <text for="L11">忍痛于怀，辅我知觉</text>
            <text for="L12">女王万岁 不绝于耳</text>
            <text for="L13">阴晴圆缺有其涨落</text>
            <text for="L14">休止声声无休无止</text>
            <text for="L15">侧耳倾听汝之心声</text>
            <text for="L16">公义之月，你会盈满我空洞的目光吗？</text>
            <text for="L17">女王万岁 不绝于耳</text>
            <text for="L18">女王万岁 不绝于耳</text>
            <text for="L19">休止声声无休无止</text>
            <text for="L20">侧耳倾听汝之心声</text>
          </translation>
        </translations>
        <transliterations></transliterations>
      </iTunesMetadata>
    </metadata>
